# Core Django Configuration
SECRET_KEY=django-insecure-shelfie-library-management-system-key-2026
DEBUG=True

# Database Configuration (Set DB_ENGINE=mysql for MySQL in production)
DB_ENGINE=sqlite3
DB_NAME=shelfie_db
DB_USER=shelfie_user
DB_PASSWORD=shelfie_password
DB_HOST=127.0.0.1
DB_PORT=3306

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=Shelfie Library <noreply@shelfie.com>
